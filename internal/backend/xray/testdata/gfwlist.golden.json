{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "›mixed",
      "protocol": "mixed",
      "listen": "127.0.0.1",
      "port": 7890,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "REJECT»",
      "protocol": "blackhole"
    },
    {
      "tag": "REJECT-DROP",
      "protocol": "blackhole"
    },
    {
      "tag": "proxy",
      "protocol": "trojan",
      "settings": {
        "address": "192.0.2.1",
        "port": 443,
        "password": "p"
      },
      "streamSettings": {
        "security": "tls",
        "tlsSettings": {
          "alpn": [
            "h2",
            "http/1.1"
          ]
        }
      }
    },
    {
      "tag": "GLOBAL",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›GLOBAL"
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "›group›GLOBAL"
        ],
        "balancerTag": "GLOBAL"
      },
      {
        "domain": [
          "domain:home.arpa",
          "domain:lan",
          "domain:local",
          "domain:localhost"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#0-3 lan"
      },
      {
        "ip": [
          "::1/128",
          "255.255.255.255/32",
          "169.254.0.0/16",
          "192.168.0.0/16",
          "172.16.0.0/12",
          "100.64.0.0/10",
          "fe80::/10",
          "0.0.0.0/8",
          "10.0.0.0/8",
          "127.0.0.0/8",
          "ff00::/8",
          "fc00::/7",
          "224.0.0.0/4"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#4-16 lan"
      },
      {
        "domain": [
          "domain:cn.example.com",
          "full:direct.example.org"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#17 https://example.com/gfwlist.txt"
      },
      {
        "domain": [
          "domain:google.com",
          "domain:googleapis.com",
          "domain:youtube.com",
          "full:www.example-path.com",
          "domain:twitter.com"
        ],
        "outboundTag": "proxy",
        "ruleTag": "#18 https://example.com/gfwlist.txt"
      },
      {
        "ip": [
          "85.17.73.31/32"
        ],
        "outboundTag": "proxy",
        "ruleTag": "#18.2 https://example.com/gfwlist.txt"
      }
    ],
    "balancers": [
      {
        "tag": "GLOBAL",
        "selector": [
          "DIRECT"
        ],
        "strategy": {
          "type": "random"
        }
      }
    ]
  }
}
