{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "›mixed",
      "protocol": "mixed",
      "listen": "127.0.0.1",
      "port": 7890,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "代理",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›代理"
      }
    },
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "REJECT»",
      "protocol": "blackhole"
    },
    {
      "tag": "REJECT-DROP",
      "protocol": "blackhole"
    },
    {
      "tag": "B1",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.21",
        "port": 1080
      }
    },
    {
      "tag": "B2",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.22",
        "port": 1080
      }
    },
    {
      "tag": "GLOBAL",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›GLOBAL"
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "›group›代理"
        ],
        "balancerTag": "代理"
      },
      {
        "inboundTag": [
          "›group›GLOBAL"
        ],
        "balancerTag": "GLOBAL"
      },
      {
        "domain": [
          "domain:a.example"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#0 a.example"
      },
      {
        "domain": [
          "domain:g.example"
        ],
        "balancerTag": "代理",
        "ruleTag": "#1 g.example"
      },
      {
        "domain": [
          "domain:home.arpa",
          "domain:lan",
          "domain:local",
          "domain:localhost"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#2-5 lan"
      },
      {
        "ip": [
          "::1/128",
          "255.255.255.255/32",
          "169.254.0.0/16",
          "192.168.0.0/16",
          "172.16.0.0/12",
          "100.64.0.0/10",
          "fe80::/10",
          "0.0.0.0/8",
          "10.0.0.0/8",
          "127.0.0.0/8",
          "ff00::/8",
          "fc00::/7",
          "224.0.0.0/4"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#6-18 lan"
      },
      {
        "domain": [
          "domain:a.example",
          "full:b.example",
          "keyword:cexample"
        ],
        "balancerTag": "代理",
        "ruleTag": "#19-21 rules-b"
      },
      {
        "domain": [
          "domain:d.example"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#22 rules-b"
      },
      {
        "ip": [
          "192.0.2.0/24",
          "198.51.100.0/24"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#23-24 rules-b"
      },
      {
        "domain": [
          "domain:e.example"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#25 rules-b"
      },
      {
        "domain": [
          "domain:f.example"
        ],
        "balancerTag": "代理",
        "ruleTag": "#26 rules-b"
      },
      {
        "port": "80,443",
        "outboundTag": "DIRECT",
        "ruleTag": "#27 rules-b"
      }
    ],
    "balancers": [
      {
        "tag": "代理",
        "selector": [
          "B1"
        ],
        "strategy": {
          "type": "random"
        }
      },
      {
        "tag": "GLOBAL",
        "selector": [
          "代理"
        ],
        "strategy": {
          "type": "random"
        }
      }
    ]
  }
}
