{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "›mixed",
      "protocol": "mixed",
      "listen": "127.0.0.1",
      "port": 7890,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "三跳»",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.3",
        "port": 3
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "三跳›2›中转"
        }
      }
    },
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "REJECT»",
      "protocol": "blackhole"
    },
    {
      "tag": "REJECT-DROP",
      "protocol": "blackhole"
    },
    {
      "tag": "入口， A",
      "protocol": "shadowsocks",
      "settings": {
        "address": "192.0.2.1",
        "port": 1,
        "method": "aes-128-gcm",
        "password": "x"
      }
    },
    {
      "tag": "中转",
      "protocol": "shadowsocks",
      "settings": {
        "address": "192.0.2.2",
        "port": 2,
        "method": "aes-128-gcm",
        "password": "x"
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "落地"
        }
      }
    },
    {
      "tag": "落地",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.3",
        "port": 3
      }
    },
    {
      "tag": "手写链",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.4",
        "port": 4
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "入口， A"
        }
      }
    },
    {
      "tag": "两跳",
      "protocol": "shadowsocks",
      "settings": {
        "address": "192.0.2.2",
        "port": 2,
        "method": "aes-128-gcm",
        "password": "x"
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "入口， A"
        }
      }
    },
    {
      "tag": "三跳›1›入口， A",
      "protocol": "shadowsocks",
      "settings": {
        "address": "192.0.2.1",
        "port": 1,
        "method": "aes-128-gcm",
        "password": "x"
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "入口组»"
        }
      }
    },
    {
      "tag": "三跳›2›中转",
      "protocol": "shadowsocks",
      "settings": {
        "address": "192.0.2.2",
        "port": 2,
        "method": "aes-128-gcm",
        "password": "x"
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "三跳›1›入口， A"
        }
      }
    },
    {
      "tag": "接力",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.3",
        "port": 3
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "两跳"
        }
      }
    },
    {
      "tag": "入口组→落地",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.3",
        "port": 3
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "入口组»"
        }
      }
    },
    {
      "tag": "入口组»",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›入口组"
      }
    },
    {
      "tag": "GLOBAL",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›GLOBAL"
      }
    }
  ],
