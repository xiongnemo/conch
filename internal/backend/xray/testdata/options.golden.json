  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "›group›GLOBAL"
        ],
        "balancerTag": "GLOBAL"
      },
      {
        "domain": [
          "domain:a.example"
        ],
        "outboundTag": "vmess-grpc",
        "ruleTag": "#0 a.example"
      },
      {
        "domain": [
          "domain:b.example"
