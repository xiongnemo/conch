{
  "log": {
    "loglevel": "info"
  },
  "inbounds": [
    {
      "tag": "›mixed",
      "protocol": "mixed",
      "listen": "127.0.0.1",
      "port": 7890,
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls",
          "quic"
        ],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "tag": "端口跳跃",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "address": "h.example.com",
        "port": 443
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "serverName": "h.example.com",
          "pinnedPeerCertSha256": "BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB:BB"
        },
        "hysteriaSettings": {
          "version": 2,
          "auth": "p"
        },
        "finalmask": {
          "udp": [
            {
              "type": "udphop",
              "settings": {
                "mode": "intervalLocal,intervalRemote",
                "interval": 30,
                "remotePorts": "443,20000-30000"
              }
            },
            {
              "type": "salamander",
              "settings": {
                "password": "o"
              }
            }
          ],
          "quicParams": {
            "congestion": "brutal",
            "brutalUp": "50000000 bps",
            "brutalDown": "200000000 bps"
          }
        }
      }
    },
    {
      "tag": "DIRECT",
      "protocol": "freedom"
    },
    {
      "tag": "REJECT»",
      "protocol": "blackhole"
    },
    {
      "tag": "REJECT-DROP",
      "protocol": "blackhole"
    },
    {
      "tag": "单端口",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "address": "h.example.com",
        "port": 443
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "serverName": "h.example.com",
          "pinnedPeerCertSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "hysteriaSettings": {
          "version": 2,
          "auth": "p"
        }
      }
    },
    {
      "tag": "跳一个端口",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "address": "192.0.2.9",
        "port": 8443
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "pinnedPeerCertSha256": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        },
        "hysteriaSettings": {
          "version": 2,
          "auth": "p"
        },
        "finalmask": {
          "udp": [
            {
              "type": "udphop",
              "settings": {
                "mode": "intervalLocal,intervalRemote",
                "remotePorts": "8443"
              }
            }
          ]
        }
      }
    },
    {
      "tag": "入口",
      "protocol": "socks",
      "settings": {
        "address": "192.0.2.7",
        "port": 1080
      }
    },
    {
      "tag": "经入口",
      "protocol": "hysteria",
      "settings": {
        "version": 2,
        "address": "h.example.com",
        "port": 443
      },
      "streamSettings": {
        "network": "hysteria",
        "security": "tls",
        "tlsSettings": {
          "serverName": "h.example.com",
          "pinnedPeerCertSha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        },
        "hysteriaSettings": {
          "version": 2,
          "auth": "p"
        },
        "sockopt": {
          "dialerProxy": "入口"
        }
      }
    },
    {
      "tag": "GLOBAL",
      "protocol": "loopback",
      "settings": {
        "inboundTag": "›group›GLOBAL"
      }
    }
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": [
          "›group›GLOBAL"
        ],
        "balancerTag": "GLOBAL"
      },
      {
        "domain": [
          "domain:a.example"
        ],
        "outboundTag": "跳一个端口",
        "ruleTag": "#0 a.example"
      },
      {
        "domain": [
          "domain:b.example"
        ],
        "outboundTag": "经入口",
        "ruleTag": "#1 b.example"
      },
      {
        "domain": [
          "domain:home.arpa",
          "domain:lan",
          "domain:local",
          "domain:localhost"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#2-5 lan"
      },
      {
        "ip": [
          "::1/128",
          "255.255.255.255/32",
          "169.254.0.0/16",
          "192.168.0.0/16",
          "172.16.0.0/12",
          "100.64.0.0/10",
          "fe80::/10",
          "0.0.0.0/8",
          "10.0.0.0/8",
          "127.0.0.0/8",
          "ff00::/8",
          "fc00::/7",
          "224.0.0.0/4"
        ],
        "outboundTag": "DIRECT",
        "ruleTag": "#6-18 lan"
      }
    ],
    "balancers": [
      {
        "tag": "GLOBAL",
        "selector": [
          "端口跳跃"
        ],
        "strategy": {
          "type": "random"
        }
      }
    ]
  }
}
