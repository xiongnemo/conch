{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "final": "local",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "›mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "tuic",
      "tag": "tuic",
      "server": "192.0.2.50",
      "server_port": 443,
      "password": "p",
      "uuid": "00000000-0000-0000-0000-000000000050",
      "congestion_control": "bbr",
      "udp_relay_mode": "quic",
      "zero_rtt_handshake": true,
      "heartbeat": "10000ms",
      "tls": {
        "enabled": true,
        "server_name": "t.example.com",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "hysteria",
      "tag": "hysteria",
      "server": "192.0.2.51",
      "server_ports": [
        "20000:30000"
      ],
      "hop_interval": "10s",
      "up_mbps": 30,
      "down_mbps": 200,
      "obfs": "o",
      "auth_str": "a",
      "tls": {
        "enabled": true,
        "server_name": "h.example.com",
        "alpn": [
          "hysteria"
        ]
      }
    },
    {
      "type": "anytls",
      "tag": "anytls",
      "server": "192.0.2.52",
      "server_port": 443,
      "password": "p",
      "idle_session_timeout": "60s",
      "tls": {
        "enabled": true,
        "server_name": "a.example.com",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "ssh",
      "tag": "ssh",
      "server": "192.0.2.53",
      "server_port": 22,
      "password": "p",
      "user": "u"
    },
    {
      "type": "snell",
      "tag": "snell",
      "server": "192.0.2.54",
      "server_port": 443,
      "version": 4,
      "psk": "k",
      "reuse": true,
      "obfs_mode": "http",
      "obfs_host": "bing.com"
    },
    {
      "type": "snell",
      "tag": "snell-shadow-tls",
      "server": "192.0.2.55",
      "server_port": 443,
      "version": 4,
      "psk": "k",
      "detour": "snell-shadow-tls›shadow-tls"
    },
    {
      "type": "shadowtls",
      "tag": "snell-shadow-tls›shadow-tls",
      "server": "192.0.2.55",
      "server_port": 443,
      "version": 3,
      "password": "st",
      "tls": {
        "enabled": true,
        "server_name": "cloud.example.com",
        "alpn": [
          "h2",
          "http/1.1"
        ]
      }
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "tuic",
        "hysteria",
        "anytls",
        "ssh",
        "snell",
        "snell-shadow-tls",
        "DIRECT"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          "a.example"
        ],
        "action": "route",
        "outbound": "hysteria"
      },
      {
        "domain_suffix": [
          "b.example"
        ],
        "action": "route",
        "outbound": "anytls"
      },
      {
        "domain_suffix": [
          "c.example"
        ],
        "action": "route",
        "outbound": "ssh"
      },
      {
        "domain_suffix": [
          "d.example"
        ],
        "action": "route",
        "outbound": "snell"
      },
      {
        "domain_suffix": [
          "e.example"
        ],
        "action": "route",
        "outbound": "snell-shadow-tls"
      },
      {
        "domain_suffix": [
          "home.arpa"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "lan"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "local"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "localhost"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "::1/128"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "255.255.255.255/32"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "169.254.0.0/16"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "192.168.0.0/16"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "172.16.0.0/12"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "fe80::/10"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "0.0.0.0/8"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "10.0.0.0/8"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "127.0.0.0/8"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "ff00::/8"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "fc00::/7"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "224.0.0.0/4"
        ],
        "action": "route",
        "outbound": "DIRECT"
      }
    ],
    "final": "tuic",
    "default_domain_resolver": "local"
  }
}
