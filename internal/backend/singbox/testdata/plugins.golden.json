{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "local"
      }
    ],
    "final": "local",
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "›mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "DIRECT"
    },
    {
      "type": "shadowsocks",
      "tag": "obfs",
      "server": "192.0.2.40",
      "server_port": 8388,
      "plugin": "obfs-local",
      "plugin_opts": "obfs=tls;obfs-host=cdn.example.com",
      "method": "aes-128-gcm",
      "password": "p"
    },
    {
      "type": "shadowsocks",
      "tag": "v2ray-plugin",
      "server": "192.0.2.41",
      "server_port": 443,
      "plugin": "v2ray-plugin",
      "plugin_opts": "mode=websocket;host=cdn.example.com;path=/v;mux=1;tls",
      "method": "aes-128-gcm",
      "password": "p"
    },
    {
      "type": "shadowsocks",
      "tag": "shadow-tls",
      "server": "192.0.2.42",
      "server_port": 443,
      "method": "2022-blake3-aes-128-gcm",
      "password": "AAAAAAAAAAAAAAAAAAAAAA==",
      "detour": "shadow-tls›shadow-tls"
    },
    {
      "type": "shadowtls",
      "tag": "shadow-tls›shadow-tls",
      "server": "192.0.2.42",
      "server_port": 443,
      "version": 3,
      "password": "st",
      "tls": {
        "enabled": true,
        "server_name": "www.example.com",
        "alpn": [
          "h2",
          "http/1.1"
        ],
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        }
      }
    },
    {
      "type": "selector",
      "tag": "GLOBAL",
      "outbounds": [
        "obfs",
        "v2ray-plugin",
        "shadow-tls",
        "DIRECT"
      ]
    }
  ],
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "domain_suffix": [
          "a.example"
        ],
        "action": "route",
        "outbound": "v2ray-plugin"
      },
      {
        "domain_suffix": [
          "b.example"
        ],
        "action": "route",
        "outbound": "shadow-tls"
      },
      {
        "domain_suffix": [
          "home.arpa"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "lan"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "local"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "domain_suffix": [
          "localhost"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "::1/128"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "255.255.255.255/32"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "169.254.0.0/16"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "192.168.0.0/16"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "172.16.0.0/12"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "100.64.0.0/10"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "fe80::/10"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "0.0.0.0/8"
        ],
        "action": "route",
        "outbound": "DIRECT"
      },
      {
        "ip_cidr": [
          "10.0.0.0/8"
        ],
        "action": "route",
